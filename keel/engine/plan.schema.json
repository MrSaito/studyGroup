{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://keel.app/schemas/plan-v1.json",
  "title": "Keel Plan v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "id", "title", "source", "version", "locale", "units"],
  "properties": {
    "schema_version": { "const": 1 },
    "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{0,63}$" },
    "title": { "type": "string", "minLength": 1 },
    "source": { "enum": ["template", "import", "coach"] },
    "version": { "type": "integer", "minimum": 1 },
    "locale": { "type": "string", "pattern": "^[a-z]{2}(-[A-Z]{2})?$" },
    "units": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "seq", "stage", "week", "type", "title", "est_minutes", "do", "is_checkpoint", "is_buffer"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{0,63}$" },
          "seq": { "type": "integer", "minimum": 1 },
          "stage": { "type": "integer", "minimum": 0 },
          "week": { "type": "integer", "minimum": 1 },
          "type": { "enum": ["learn", "build", "review", "rest"] },
          "title": { "type": "string", "minLength": 1 },
          "est_minutes": { "type": "integer", "minimum": 1 },
          "learn": { "type": "string" },
          "do": { "type": "string", "minLength": 1 },
          "tip": { "type": "string" },
          "deliverable": { "type": "string" },
          "is_checkpoint": { "type": "boolean" },
          "is_buffer": { "type": "boolean" }
        }
      }
    }
  }
}
